# Copy this to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Postgres connection string used by knexfile.js's `production` block.
# docker-compose.yml builds this automatically from POSTGRES_PASSWORD below —
# only set it here yourself if you're running the app outside Docker.
# DATABASE_URL=postgres://fixify:changeme@localhost:5432/fixify

# Password for the Postgres container in docker-compose.yml. Pick a strong
# one — this file lives on your VPS, not in git.
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Notifications — defaults to console logging if unset (see README)
# ---------------------------------------------------------------------------
# NOTIFICATION_PROVIDER=africastalking
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=

# ---------------------------------------------------------------------------
# Payments (collection) — driver -> platform wallet.
# Leave unset to use the `mock` provider (safe default, no real money moves).
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=intasend
# INTASEND_PUBLIC_KEY=
# INTASEND_WALLET_ID=
# INTASEND_ENV=sandbox   # sandbox | live

# Real Safaricom Daraja is also supported as an alternative to IntaSend for
# collection only (no payout/escrow split — see README).
# PAYMENT_PROVIDER=daraja
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-domain/api/payments/mpesa/callback
# MPESA_ENV=sandbox   # sandbox | production

# Kopo Kopo (K2 Connect) is a third collection option — Kenya-native, and
# unlike IntaSend's currently invite-gated sandbox, Kopo Kopo's sandbox
# signup is self-serve. See README "Going live with Kopo Kopo".
# PAYMENT_PROVIDER=kopokopo
# KOPOKOPO_CLIENT_ID=
# KOPOKOPO_CLIENT_SECRET=
# KOPOKOPO_TILL_NUMBER=
# KOPOKOPO_CALLBACK_URL=https://your-domain/api/payments/kopokopo/callback
# KOPOKOPO_ENV=sandbox   # sandbox | production

# ---------------------------------------------------------------------------
# Payouts (disbursement) — platform wallet -> vendor's M-Pesa, net of
# commission. Leave unset to use the `mock` provider.
# ---------------------------------------------------------------------------
# PAYOUT_PROVIDER=intasend
# INTASEND_SECRET_KEY=
# INTASEND_DEVICE_ID=
# INTASEND_SENDMONEY_CALLBACK_URL=https://your-domain/api/payouts/intasend/callback
# See README "Going live with IntaSend payouts" — the disbursement approval
# step needs an RSA key registered in your IntaSend dashboard first.

# Kopo Kopo also supports payouts (Send Money to an external M-Pesa number),
# reusing the same KOPOKOPO_CLIENT_ID/SECRET/TILL_NUMBER as collection above
# (confirmed empirically — the till number doubles as source_identifier).
# PAYOUT_PROVIDER=kopokopo
# KOPOKOPO_SENDMONEY_CALLBACK_URL=https://your-domain/api/payouts/kopokopo/callback

# Platform commission taken from every completed job, 0-1 (default 0.15 = 15%)
# PLATFORM_COMMISSION_RATE=0.15
